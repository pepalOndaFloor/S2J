CREATE OR REPLACE FUNCTION check_item(p_item_id NUMBER)
RETURN NUMBER
IS
    cnt NUMBER;
BEGIN
    SELECT COUNT(*)
    INTO cnt
    FROM items
    WHERE item_id = p_item_id;

    IF cnt > 0 THEN
        RETURN 1;   -- Item exists
    ELSE
        RETURN 0;   -- Item does not exist
    END IF;
END;

