SQL queries: 
Creating tables: 
1. client_master 
CREATE TABLE client_master ( 
client_no VARCHAR(10) PRIMARY KEY, 
name VARCHAR(30) NOT NULL, 
address1 VARCHAR(20), 
address2 VARCHAR(20), 
city VARCHAR(30), 
pincode INT, 
state VARCHAR(50), 
bal_due DECIMAL(10,2), 
CHECK (client_no LIKE 'C%') 
); 
2. product_master 
CREATE TABLE product_master ( 
product_no VARCHAR(10) PRIMARY KEY, 
description VARCHAR(50), 
profit_percent DECIMAL(5,2), 
unit_measure VARCHAR(10), 
qty_on_hand INT, 
reorder_lvl INT, 
sell_price DECIMAL(10,2), 
cost_price DECIMAL(10,2), 
CHECK (product_no LIKE 'P%') 
); 
3. salesman_master 
CREATE TABLE salesman_master ( 
salesman_no VARCHAR(10) PRIMARY KEY, 
salesman_name VARCHAR(30) NOT NULL, 
address1 VARCHAR(20), 
address2 VARCHAR(20), 
city VARCHAR(30), 
pincode INT, 
state VARCHAR(30), 
sal_amt DECIMAL(10,2), 
tgt_to_get DECIMAL(10,2), 
ytd_sales DECIMAL(10,2), 
remarks VARCHAR(40), 
CHECK (salesman_no LIKE 'S%') 
); 
4. sales_order 
CREATE TABLE Sales_order( 
order_no VARCHAR(10) PRIMARY KEY, 
order_date DATE, 
client_no VARCHAR(10), 
del_addr VARCHAR(60), 
salesman_no VARCHAR(20), 
del_type CHAR(1) DEFAULT 'F', 
billed_yn  CHAR(1), 
del_date DATE, 
order_status VARCHAR(15), 
CHECK(order_no LIKE 'O%'), 
CHECK(del_type IN ('P','F')), 
CHECK(del_date >= order_date), 
CHECK(order_status IN ('InProcess','Fullfilled','BackOrder','Cancelled')), 
FOREIGN KEY(client_no) REFERENCES client_master(client_no), 
FOREIGN KEY(salesman_no) REFERENCES salesman_master(salesman_no)           
); 
5. sales_order_details 
CREATE TABLE sales_order_details ( 
order_no varchar(10) DEFAULT NULL, 
product_no varchar(10) DEFAULT NULL, 
qty_ordered int(11) DEFAULT NULL, 
qty_dispatched int(11) DEFAULT NULL, 
product_rate decimal(10,2) DEFAULT NULL 
); 
